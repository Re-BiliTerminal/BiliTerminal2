<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    app:animScaleSV="false">

    <com.huanli233.bilizepam.ui.widget.scalablecontainer.AppScrollView
        android:id="@+id/scroll_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:animScaleSV="false">
        <com.huanli233.bilizepam.ui.widget.wearable.BoxInsetLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/content_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/page_padding_horizontal"
                android:paddingBottom="@dimen/page_bottom_padding"
                android:visibility="invisible"
                tools:visibility="visible">

                <androidx.constraintlayout.utils.widget.ImageFilterView
                    android:id="@+id/cover"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginHorizontal="5dp"
                    android:focusable="true"
                    android:clickable="true"
                    android:contentDescription="@null"
                    app:round="5dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintDimensionRatio="16:9"/>

                <TextView
                    android:id="@+id/duration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="@+id/cover"
                    app:layout_constraintEnd_toEndOf="@+id/cover"
                    android:alpha="0.9"
                    android:shadowColor="@android:color/black"
                    android:textColor="@android:color/white"
                    android:shadowDx="3"
                    android:shadowDy="3"
                    android:shadowRadius="5"
                    android:textStyle="bold"
                    android:paddingEnd="4dp"
                    android:paddingRight="4dp"
                    android:paddingBottom="2dp"
                    tools:text="12:34" />

                <TextView
                    android:id="@+id/title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    app:layout_constraintTop_toBottomOf="@+id/cover"
                    app:layout_constraintStart_toStartOf="parent"
                    android:textStyle="bold"
                    android:layout_marginHorizontal="3dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    tools:text="Video Title" />

                <TextView
                    android:id="@+id/views"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    tools:text="2415"
                    app:layout_constraintTop_toBottomOf="@+id/title"
                    app:layout_constraintStart_toStartOf="parent"
                    app:drawableStartCompat="@drawable/icon_play_16"
                    android:drawablePadding="2dp"/>

                <TextView
                    android:id="@+id/danmakus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="@+id/views"
                    app:layout_constraintStart_toEndOf="@+id/views"
                    app:drawableStartCompat="@drawable/icon_danmaku"
                    android:drawablePadding="2dp"
                    android:layout_marginStart="5dp"
                    android:layout_marginLeft="5dp"
                    tools:text="5142" />

                <TextView
                    android:id="@+id/publish_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/views"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginTop="1dp"
                    app:drawableStartCompat="@drawable/icon_schedule_16"
                    android:drawablePadding="2dp"
                    tools:text="2021-01-01 00:00:00" />

                <TextView
                    android:id="@+id/bvid"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toBottomOf="@+id/publish_time"
                    app:layout_constraintStart_toStartOf="parent"
                    android:layout_marginTop="1dp"
                    app:drawableStartCompat="@drawable/icon_movie_16"
                    android:drawablePadding="2dp"
                    tools:text="BVMAIMAI" />

                <com.huanli233.bilizepam.ui.widget.views.ExpandableTextView
                    android:id="@+id/desc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/bvid"
                    android:layout_marginTop="5dp"
                    app:maxCollapsedLines="3"
                    app:animDuration="200"
                    tools:text="简介" >
                    <TextView
                        android:id="@id/expandable_text"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="13sp" />

                    <ImageButton
                        android:id="@id/expand_collapse"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:contentDescription="@null"
                        android:paddingTop="5dp"
                        android:paddingEnd="6dp"
                        android:paddingRight="6dp"
                        android:layout_gravity="end|bottom"
                        android:background="@android:color/transparent"
                        app:tint="?attr/colorOnSurface" />
                </com.huanli233.bilizepam.ui.widget.views.ExpandableTextView>

                <ImageView
                    android:id="@+id/tags_icon"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:srcCompat="@drawable/icon_keyboard_arrow_down"
                    android:contentDescription="@null"
                    android:layout_marginTop="5dp"
                    app:layout_constraintTop_toBottomOf="@+id/desc"
                    app:layout_constraintStart_toStartOf="parent" />

                <com.huanli233.bilizepam.ui.widget.views.NoSpaceTextView
                    android:id="@+id/tags_tip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorPrimary"
                    app:layout_constraintStart_toEndOf="@+id/tags_icon"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintTop_toTopOf="@+id/tags_icon"
                    app:layout_constraintBottom_toBottomOf="@+id/tags_icon"
                    android:text="@string/tag"/>

                <net.cachapa.expandablelayout.ExpandableLayout
                    android:id="@+id/tags_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tags_tip"
                    android:clipChildren="false">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/tags"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:chipSpacing="3dp"
                        app:chipSpacingHorizontal="3dp"
                        app:chipSpacingVertical="2dp"
                        android:clipChildren="false"/>

                </net.cachapa.expandablelayout.ExpandableLayout>

                <com.google.android.material.button.MaterialButton
                    style="?attr/materialIconButtonFilledStyle"
                    android:id="@+id/play"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/play"
                    app:icon="@drawable/icon_play_circle"
                    app:iconPadding="5dp"
                    android:layout_marginTop="10dp"
                    app:layout_constraintTop_toBottomOf="@id/tags_layout"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <HorizontalScrollView
                    android:id="@+id/toolbar1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    app:layout_constraintTop_toBottomOf="@+id/play"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">
                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton
                            style="?attr/materialIconButtonOutlinedStyle"
                            android:id="@+id/like"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:icon="@drawable/icon_thumb_up_20"
                            app:iconPadding="3dp"
                            app:iconGravity="textTop"
                            app:iconTint="?attr/colorAccent"
                            android:text="@string/like"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintDimensionRatio="1:1"/>

                        <com.google.android.material.button.MaterialButton
                            style="?attr/materialIconButtonOutlinedStyle"
                            android:id="@+id/coin"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:icon="@drawable/icon_coin"
                            app:iconPadding="3dp"
                            app:iconGravity="textTop"
                            android:text="@string/coin"
                            app:iconTint="?attr/colorAccent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/like"
                            app:layout_constraintDimensionRatio="1:1"/>

                        <com.google.android.material.button.MaterialButton
                            style="?attr/materialIconButtonOutlinedStyle"
                            android:id="@+id/favorite"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            app:icon="@drawable/icon_star_20"
                            app:iconPadding="3dp"
                            app:iconGravity="textTop"
                            android:text="@string/coin"
                            app:iconTint="?attr/colorAccent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintStart_toEndOf="@+id/coin"
                            app:layout_constraintDimensionRatio="1:1"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>
                </HorizontalScrollView>


            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.huanli233.bilizepam.ui.widget.wearable.BoxInsetLayout>
    </com.huanli233.bilizepam.ui.widget.scalablecontainer.AppScrollView>

    <com.huanli233.bilizepam.ui.widget.components.LoadingView
        android:id="@+id/loading_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:visibility="invisible" />

</FrameLayout>